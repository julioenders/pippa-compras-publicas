# Database
# Para desenvolvimento local (SQLite - sem instalacao extra):
DATABASE_URL=sqlite+aiosqlite:///./pippa_compras.db

# Para producao (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/pippa_compras

# External APIs (all GET endpoints are public, no keys needed)
# PNCP - no auth required
# Querido Diário - no auth required
# Dados Abertos Compras - no auth required

# Observatório SEBRAE - token required
OBSERVATORIO_TOKEN=

# CORS (separar com virgula para multiplas origens)
CORS_ORIGINS=http://localhost:5173,https://julioenders.github.io

# Logging
LOG_LEVEL=INFO

# Collection schedule (UTC)
COLLECTION_CRON_HOUR=6
COLLECTION_CRON_MINUTE=0
